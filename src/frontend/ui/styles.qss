QWidget {
    background-color: #1e1e1e;
    color: #cccccc;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 14px;
}

QPushButton {
    background-color: #0e639c;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 10px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #1177bb;
}

QPushButton:pressed {
    background-color: #094771;
}

QPushButton#saveButton {
    background-color: #237a46;
    border: 1px solid #4cb875;
}

QPushButton#saveButton:hover {
    background-color: #2d9457;
}

QPushButton#saveButton:pressed {
    background-color: #195d34;
}

QPushButton#saveButton:disabled {
    background-color: #304a3b;
    color: #a6b6ac;
    border-color: #486151;
}

QLineEdit {
    background-color: #3c3c3c;
    border: 1px solid #555555;
    padding: 8px;
    border-radius: 4px;
    color: white;
}

QListWidget {
    background-color: #252526;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    outline: none;
}

QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid #333333;
}

QListWidget::item:selected {
    background-color: #04395e;
    color: white;
}

QListWidget::item:hover {
    background-color: #2a2d2e;
}

QMessageBox {
    background-color: #252526;
}

QLabel {
    color: #ffffff;
    background: transparent;
}

QGraphicsView {
    background-color: #1e1e1e;
    border: 1px solid #3c3c3c;
}

QPushButton#handwritingButton, QPushButton#sketchButton {
    font-size: 18px;
    border-radius: 8px;
    border: 3px solid transparent;
    padding: 18px;
}

QPushButton#handwritingButton {
    background-color: #094771;
    border-color: #2579b0;
}

QPushButton#handwritingButton:hover, QPushButton#handwritingButton:checked {
    background-color: #0e639c;
}

QPushButton#sketchButton {
    background-color: #50335f;
    border-color: #9661ab;
}

QPushButton#sketchButton:hover, QPushButton#sketchButton:checked {
    background-color: #70448a;
}

QPushButton#handwritingButton:checked, QPushButton#sketchButton:checked {
    border: 3px solid #ffffff;
}

QPushButton#handwritingButton:focus, QPushButton#sketchButton:focus {
    border-style: dashed;
}

QPushButton#handwritingButton:disabled, QPushButton#sketchButton:disabled {
    background-color: #343438;
    color: #909094;
    border-color: #4a4a50;
}
